{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "headless-angular/tooltip",
  "version": "0.1.0",
  "title": "Headless Angular Tooltip",
  "category": "text",
  "icon": "editor-help",
  "description": "Accessible static tooltip text for the headless renderer.",
  "textdomain": "headless-angular-schema",
  "attributes": { "label": { "type": "string", "default": "More information" }, "content": { "type": "string", "default": "Helpful information." } },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "supports": { "anchor": true, "html": false, "color": { "text": true, "background": true }, "typography": { "fontSize": true, "fontFamily": true, "fontWeight": true }, "spacing": { "margin": true, "padding": true } }
}
