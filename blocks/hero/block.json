{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "headless-angular/hero",
  "version": "0.1.1",
  "title": "Headless Angular Hero",
  "category": "design",
  "icon": "cover-image",
  "description": "Collects normalized hero content for the PageSchema contract.",
  "textdomain": "headless-angular-schema",
  "attributes": {
    "id": {
      "type": "string"
    },
    "eyebrow": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "media": {
      "type": "object"
    },
    "actions": {
      "type": "array",
      "default": []
    },
    "layout": {
      "type": "object"
    },
    "style": {
      "type": "object"
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "supports": {
    "align": false,
    "html": false,
    "customClassName": false
  }
}
